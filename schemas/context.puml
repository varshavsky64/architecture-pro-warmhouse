@startuml
' встроенная раскладка: диаграмма рисуется без установленного Graphviz
!pragma layout smetana
!include <C4/C4_Context>

title Диаграмма контекста: текущая система «Тёплый дом»

Person(user, "Пользователь", "Владелец дома. Удалённо включает и выключает отопление, смотрит текущую температуру")
System(monolith, "Монолит «Тёплый дом»", "Управляет отоплением и показывает температуру в домах")
System_Ext(sensors, "Датчики в домах", "Устанавливает специалист при выезде. Отдают температуру и принимают команды")

Rel(user, monolith, "Включает и выключает отопление, смотрит текущую температуру", "Веб-интерфейс, REST/HTTP, JSON, синхронно")
Rel(monolith, sensors, "Запрашивает текущую температуру, отправляет команды включения и выключения", "REST/HTTP, JSON, синхронно")

SHOW_LEGEND()
@enduml
